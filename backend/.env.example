# Startup and Prisma CLI explicitly load backend/.env; shell variables take precedence.
# Optional override: a decimal integer from 1 to 65535; defaults to 3001.
PORT=3001
# POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB in DATABASE_URL are placeholders.
# They are not automatically interpolated or loaded from root .env.
# Replace POSTGRES_USER and POSTGRES_DB with the matching values from root .env.
# Replace POSTGRES_PASSWORD with root .env's password, percent-encoded for the URL.
# For example, encode @ as %40; keep the original password in root .env.
# Use host port 5433; PostgreSQL listens on port 5432 inside the container.
DATABASE_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@127.0.0.1:5433/POSTGRES_DB

# Browser origins are exact, without paths/trailing slashes; no wildcard matching.
# Local HTTP requires loopback origins using the same hostname; keep UI port 3000.
API_PUBLIC_ORIGIN=http://localhost:3001
AUTH_ALLOWED_ORIGINS=http://localhost:3000
AUTH_COOKIE_MODE=local-http
# NODE_ENV=production requires AUTH_COOKIE_MODE=https and explicit HTTPS origins.
# Deploy UI/API under one controlled same-site domain; never trust forwarded headers blindly.
