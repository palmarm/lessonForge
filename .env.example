# Docker Compose reads root .env. Replace these placeholders before first startup.
# Replace YOUR_DATABASE_NAME with lessonforge_dev for the local-only test:db check.
POSTGRES_DB=YOUR_DATABASE_NAME
# Replace YOUR_DATABASE_USER with lessonforge.
POSTGRES_USER=YOUR_DATABASE_USER
# Replace YOUR_DATABASE_PASSWORD with your own local password.
POSTGRES_PASSWORD=YOUR_DATABASE_PASSWORD
