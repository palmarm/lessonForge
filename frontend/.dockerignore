# Install and generate inside Linux, never reuse host/native outputs.
**/node_modules
**/.next
**/out
**/dist
**/coverage
**/*.tsbuildinfo

# Exclude all environment files, including examples, and local credentials.
**/.env
**/.env.*
**/.npmrc
**/.netrc
**/.git-credentials
**/.aws
**/.ssh
**/.codex
**/.vercel
**/.docker
**/secrets
**/credentials
**/*.pem
**/*.key
**/*.p12
**/*.pfx

**/*.log
**/.cache
**/.npm
**/.turbo
**/.yarn
**/.eslintcache
**/__pycache__
**/.git
**/.vscode
**/.idea
**/.DS_Store
**/Thumbs.db
